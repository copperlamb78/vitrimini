# Servidor e URLs Públicas (VitriMini)
PORT=3333
NODE_ENV=production
FRONTEND_URL=https://vitrimini.com.br
BACKEND_PUBLIC_URL=https://api.vitrimini.com.br

# Banco de Dados PostgreSQL (Supabase)
# DATABASE_URL: Connection Pooling (Transaction Pooler, porta 6543, com ?pgbouncer=true)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL: Conexão Direta / Session Pooler (porta 5432, usada pelo Prisma db push / migrate)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Autenticação JWT (Lojistas)
JWT_SECRET="troque-este-segredo-jwt-em-producao"

# Super Admin (lista de e-mails separados por vírgula autorizados em painel.vitrimini.com.br)
ADMIN_EMAILS="admin@vitrimini.com.br"

# Armazenamento de Imagens (Cloudflare R2 — S3 Compatible)
R2_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=vitrimini
R2_PUBLIC_URL="https://cdn.vitrimini.com.br"

# E-mail Transacional (Brevo API v3 — recomendada no Render; SMTP opcional em dev)
BREVO_API_KEY=xkeysib-sua-api-key-v3-aqui
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=seu-usuario-smtp@smtp-brevo.com
SMTP_PASS=sua-chave-smtp-aqui
SMTP_FROM="VitriMini <suporte@vitrimini.com.br>"

# Pagamento Pix (Mercado Pago Orders API v2)
# Defina MOCK_PIX=false em produção com seu MP_ACCESS_TOKEN
MOCK_PIX=false
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
CATALOG_PRICE_CENTS=2490

# Integração OAuth Mercado Pago dos Lojistas (Plano Pro)
MP_APP_ID=
MP_CLIENT_SECRET=
MP_OAUTH_REDIRECT_URI=https://api.vitrimini.com.br/api/integrations/mercadopago/callback

# Túnel local opcional para testar Webhooks em desenvolvimento
NGROK_AUTHTOKEN=
