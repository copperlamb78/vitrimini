generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum CatalogStatus {
  DRAFT      // Aguardando pagamento ou prévia de demonstração
  ACTIVE     // Pago e público
  EXPIRED    // Expirado
}

enum CatalogPlanType {
  ESSENTIAL
  PRO
}

enum OrderPaymentChannel {
  WHATSAPP
  MERCADO_PAGO
}

enum OrderPaymentStatus {
  PENDING
  PAID
  CANCELLED
}

enum PaymentType {
  CREATION   // Primeira ativação da vitrine
  RENEWAL    // Renovação de +90 dias
}

enum PaymentRecordStatus {
  PENDING
  PAID
}

enum OrderStatus {
  PENDING
  PREPARING
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

enum DeliveryType {
  PICKUP
  DELIVERY
}

enum OrderPaymentMethod {
  PIX
  CARD
  CASH
  OTHER
}

enum EmailLogStatus {
  SENT
  FAILED
}

model User {
  id                     String           @id @default(uuid())
  name                   String
  email                  String           @unique
  phone                  String           // WhatsApp cadastrado (apenas números com DDI, ex: 5575999999999)
  passwordHash           String
  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?
  hasUsedTrial           Boolean          @default(false)
  termsAcceptedAt        DateTime?
  privacyAcceptedAt      DateTime?
  termsVersion           String?
  lastLoginAt            DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  catalogs               Catalog[]
  payments               CatalogPayment[]
  refreshTokens          RefreshToken[]
  orders                 Order[]
  couponRedemptions      PromoCouponRedemption[]

  @@index([lastLoginAt])
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Catalog {
  id            String           @id @default(uuid())
  slug          String           @unique
  editToken     String           @unique @default(uuid())
  status        CatalogStatus    @default(DRAFT)

  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  renewalCount  Int              @default(0) // Quantas vezes esta vitrine foi renovada
  isTrial       Boolean          @default(false) // Se foi ativada com 15 dias grátis iniciais
  planType      CatalogPlanType  @default(ESSENTIAL)

  storeName     String
  logoUrl       String?          // Caminho relativo da foto/logo, ex: /uploads/logo-uuid.webp
  themeColor    String           @default("rose") // Identificador do tema de cor escolhido
  whatsapp            String           // Apenas números com DDI, ex: 5575999999999
  pixKey              String?          // Chave Pix do lojista para receber o sinal dos clientes
  depositPct          Int              @default(50) // Porcentagem de sinal (0, 50 ou 100)
  minOrderCents       Int              @default(0) // Valor mínimo do pedido em centavos (0 = sem mínimo)
  paymentNotice       String?          // Aviso personalizado de pagamento exibido na vitrine
  deliveryDates       String[]         // Ex: ["24/12 (Qui) • Manhã", "24/12 (Qui) • Tarde"]
  notes               String?          // Regras gerais da loja
  pickupAddress       String?          // Endereço da loja para retirada
  pickupInstructions  String?          // Horário ou instruções de retirada
  deliveryEstimate    String?          // Previsão padrão de entrega

  paymentId            String?
  expiresAt            DateTime?
  billingType          String           @default("PIX_ONE_OFF")
  mpPreapprovalId      String?
  subscriptionStatus   String?
  autoRenew            Boolean          @default(false)
  canceledAt           DateTime?
  nextBillingAt        DateTime?
  mpUserId             String?
  mpAccessToken        String?
  mpRefreshToken       String?
  mpTokenExpiresAt     DateTime?
  onlinePaymentEnabled Boolean          @default(false)
  mpAcceptPix          Boolean          @default(true)
  mpAcceptCard         Boolean          @default(true)
  notifyOrderByEmail   Boolean          @default(true)
  notified7DaysBefore       Boolean          @default(false)
  notifiedExpiration        Boolean          @default(false)
  lastExpirationNoticeStage String?
  lastExpirationNoticeAt    DateTime?
  bioLinksConfig            Json?
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt

  products          Product[]
  payments          CatalogPayment[]
  orders            Order[]
  couponRedemptions PromoCouponRedemption[]

  @@index([userId])
  @@index([status])
  @@index([status, expiresAt])
  @@index([whatsapp, isTrial])
  @@index([mpPreapprovalId])
}

model Product {
  id          String      @id @default(uuid())
  catalogId   String
  catalog     Catalog     @relation(fields: [catalogId], references: [id], onDelete: Cascade)

  name        String
  description String?
  priceCents  Int         // Sempre em centavos
  imageUrl    String?     // URL pública no Cloudflare R2
  orderIndex  Int         @default(0)
  available   Boolean     @default(true)

  orderItems  OrderItem[]

  @@index([catalogId, available])
}

model CatalogPayment {
  id          String              @id @default(uuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  catalogId   String
  catalog     Catalog             @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  type           PaymentType         @default(CREATION)
  planCode       String              @default("ESSENTIAL_90D")
  status         PaymentRecordStatus @default(PENDING)
  amountCents    Int                 // Ex: 2490
  feeCents       Int?
  netAmountCents Int?
  gatewayId               String?             // ID da Order/Payment no Mercado Pago
  autoRenewConsentAt      DateTime?
  autoRenewConsentVersion String?
  paidAt                  DateTime?
  createdAt               DateTime            @default(now())

  @@unique([gatewayId])
  @@index([status, createdAt])
  @@index([catalogId])
}

model Order {
  id              String             @id @default(uuid())
  orderNumber     Int
  trackingCode    String             @unique
  catalogId       String
  catalog         Catalog            @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  userId          String?
  user            User?              @relation(fields: [userId], references: [id], onDelete: SetNull)

  customerName    String
  customerPhone   String             // Apenas dígitos normalizados (ex: 5575999999999)
  deliveryType    DeliveryType       @default(PICKUP)
  deliveryAddress String?
  deliveryDate    String?
  paymentMethod   OrderPaymentMethod  @default(PIX)
  paymentChannel  OrderPaymentChannel @default(WHATSAPP)
  paymentStatus   OrderPaymentStatus  @default(PENDING)
  mpPaymentId     String?
  notes           String?
  status          OrderStatus         @default(PENDING)
  totalCents      Int
  mpFeeCents      Int?
  netAmountCents  Int?

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  items           OrderItem[]

  @@unique([catalogId, orderNumber])
  @@index([catalogId, createdAt])
  @@index([catalogId, status])
  @@index([userId, createdAt])
  @@index([mpPaymentId])
}

model OrderItem {
  id             String   @id @default(uuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  productName    String
  unitPriceCents Int
  quantity       Int

  @@index([orderId])
  @@index([productId])
}

model EmailLog {
  id           String         @id @default(uuid())
  type         String
  recipient    String
  status       EmailLogStatus
  errorMessage String?
  createdAt    DateTime       @default(now())

  @@index([createdAt, status])
}

model AdminAuditLog {
  id          String   @id @default(uuid())
  adminUserId String
  adminEmail  String
  action      String
  targetType  String
  targetId    String
  targetLabel String?
  beforeJson  Json?
  afterJson   Json?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([targetType, targetId, createdAt])
  @@index([action, createdAt])
}

model SystemErrorLog {
  id              String    @id @default(uuid())
  fingerprint     String    @unique
  source          String
  severity        String
  category        String
  message         String
  stack           String?
  route           String?
  method          String?
  statusCode      Int?
  userId          String?
  catalogId       String?
  contextJson     Json?
  occurrenceCount Int       @default(1)
  status          String    @default("OPEN")
  resolutionNote  String?
  resolvedAt      DateTime?
  firstSeenAt     DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())

  @@index([status, lastSeenAt(sort: Desc)])
  @@index([source, severity])
  @@index([lastSeenAt])
}

model PaymentWebhookLog {
  id                 String    @id @default(uuid())
  provider           String    @default("MERCADO_PAGO")
  eventType          String
  externalResourceId String?
  catalogId          String?
  paymentId          String?
  status             String
  httpStatus         Int?
  errorMessage       String?
  payloadJson        Json?
  processedAt        DateTime?
  createdAt          DateTime  @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@index([externalResourceId])
}

model PromoCoupon {
  id               String                  @id @default(uuid())
  code             String                  @unique
  description      String?
  type             String                  @default("EXTENDED_TRIAL")
  bonusDays        Int
  targetPlanCode   String?
  maxUses          Int?
  usedCount        Int                     @default(0)
  expiresAt        DateTime?
  isActive         Boolean                 @default(true)
  createdByAdminId String
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  redemptions PromoCouponRedemption[]

  @@index([isActive, expiresAt])
}

model PromoCouponRedemption {
  id         String      @id @default(uuid())
  couponId   String
  coupon     PromoCoupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  catalogId  String?
  catalog    Catalog?    @relation(fields: [catalogId], references: [id], onDelete: SetNull)
  redeemedAt DateTime    @default(now())

  @@unique([couponId, userId])
  @@index([userId])
  @@index([couponId, redeemedAt])
}

model GlobalAnnouncement {
  id               String    @id @default(uuid())
  title            String
  message          String
  variant          String    @default("INFO")
  ctaLabel         String?
  ctaUrl           String?
  isActive         Boolean   @default(false)
  startsAt         DateTime?
  endsAt           DateTime?
  dismissible      Boolean   @default(true)
  updatedByAdminId String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([isActive, startsAt, endsAt])
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
